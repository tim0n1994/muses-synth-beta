# Optional environment reference. Muses does not automatically load .env files.
# Set values in the process environment only when needed.
MUSES_PORT=3001
MUSES_DATABASE_PATH=.muses/muses.sqlite
MUSES_AUTH_ENABLED=false

# Authentication is optional for a trusted local beta. If enabled in production,
# provide a strong MUSES_JWT_SECRET through a protected environment.
# MUSES_JWT_SECRET=
