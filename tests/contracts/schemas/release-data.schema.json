{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "muses://contracts/release-data",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "key", "status", "config", "createdAt"],
  "properties": {
    "releaseId": { "type": "string", "pattern": "^rel_[A-Za-z0-9_-]{4,120}$" },
    "key": { "const": "interaction-shell" },
    "status": { "enum": ["published", "rolled_back"] },
    "config": { "$ref": "muses://contracts/shell-config" },
    "createdAt": { "type": "string" },
    "rolledBackFrom": {
      "type": "string",
      "pattern": "^rel_[A-Za-z0-9_-]{4,120}$"
    }
  }
}
