{
  "name": "muses-v0.1",
  "version": "0.3.3-beta.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=11.4.0 <12"
  },
  "scripts": {
    "clean": "node --input-type=module --eval=\"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "dev": "concurrently --kill-others --names server,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "watch": "tsx src/server/cli/main.ts watch",
    "backfill": "tsx src/server/cli/main.ts backfill",
    "build": "node scripts/build-identity.mjs build",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "start": "NODE_ENV=production MUSES_SERVE_STATIC=true node dist/server/index.js",
    "start:e2e": "node scripts/start-e2e-server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.server.json --pretty false && tsc -p tsconfig.web.json --pretty false && tsc -p tsconfig.tools.json --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test --config playwright.config.ts",
    "audit:prod": "node scripts/release/audit.mjs",
    "gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:contracts && pnpm test:release && pnpm check:public && pnpm check:secrets && pnpm build && pnpm test:e2e && pnpm test:e2e:media && pnpm audit:prod",
    "check:public": "node scripts/release/check-public.mjs",
    "check:secrets": "node scripts/release/security.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "release:package": "node scripts/release/package.mjs",
    "release:smoke": "node scripts/release/smoke.mjs",
    "test:e2e:media": "playwright test --config tests/e2e/audio-media.config.ts audio-media.spec.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-switch": "1.3.7",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-query": "5.101.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.1",
    "fastify": "5.12.7",
    "pino": "9.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-router-dom": "7.18.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.30",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
